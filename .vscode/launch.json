    "version": "0.2.0",
    "configurations": [
        {
            "name": "Example: Atlas Check",
            "type": "debugpy",
            "request": "launch",
            "program": "positronixlab/downstream_tasks/compositionality/examples/example_atlas.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Example: UI",
            "type": "debugpy",
            "request": "launch",
            "program": "positronixlab/modularui/examples/example_ui.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Trial: AtlasCompose",
            "type": "debugpy",
            "request": "launch",
            "program": "positronixlab/atlas_compose/trial_atlas_compose_v1.py",
            "console": "integratedTerminal",
            //"subProcess": false
        },
        {
            "name": "Example: Train",
            "type": "debugpy",
            "request": "launch",
            "program": "positronixlab/deeplearning/examples/example_train.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Example: PubSub",
            "type": "debugpy",
            "request": "launch",
            "program": "positronixlab/plugin/examples/example_pubsub.py",
            "console": "integratedTerminal",
            "justMyCode": false,
        },
        {
            "name": "Example: Count",
            "type": "debugpy",
            "request": "launch",
            "program": "positronixlab/plugin/examples/example_count.py",
            "console": "integratedTerminal",
            "justMyCode": false,
        },
        {
            "name": "Run: File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
        },
        {
            "name": "Test: Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "${file}"
            ]
        },
        {
            "name": "Test: All",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "."
            ]
        },
        {
            "name": "Tests All",
            "type": "debugpy",
            "request": "launch",
            "program": "bin/ui.py",
            "console": "integratedTerminal",
            "args": [
                "start"
            ]
        },
    ]
}