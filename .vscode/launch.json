{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Trial: ModularNet",
            "type": "debugpy",
            "request": "launch",
            "program": "modularnet/modularnet/trail_modularnet_v1.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Example: Train",
            "type": "debugpy",
            "request": "launch",
            "program": "modularnet/deeplearning/examples/example_train.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Example: PubSub",
            "type": "debugpy",
            "request": "launch",
            "program": "modularnet/plugin/examples/example_pubsub.py",
            "console": "integratedTerminal",
            "justMyCode": false,
        },
        {
            "name": "Example: Count",
            "type": "debugpy",
            "request": "launch",
            "program": "modularnet/plugin/examples/example_count.py",
            "console": "integratedTerminal",
            "justMyCode": false,
        },
        {
            "name": "Run: File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
        },
        {
            "name": "Test: Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "${file}"
            ]
        },
        {
            "name": "Test: All",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "."
            ]
        },
        {
            "name": "Tests All",
            "type": "debugpy",
            "request": "launch",
            "program": "bin/ui.py",
            "console": "integratedTerminal",
            "args": [
                "start"
            ]
        },
    ]
}