{
    "name": "debugpy-spawn",
    "displayName": "debugpy-spawn",
    "description": "Auto-attach debugger to Python subprocess workers using the spawn start method.",
    "version": "0.0.1",
    "publisher": "cesare-montresor",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/cesare-montresor/debugpy-spawn"
    },
    "engines": { "vscode": "^1.80.0" },
    "activationEvents": ["onDebug"],
    "enabledApiProposals": ["terminalDataWriteEvent"],
    "main": "./extension.js",
    "contributes": {
        "configuration": {
            "title": "debugpy-spawn",
            "properties": {
                "debugpySpawn.portPattern": {
                    "type": "string",
                    "default": "Debugger listening on port (\\d+)",
                    "description": "Regex pattern to detect debugger port from worker output. Must contain one capture group for the port number."
                },
                "debugpySpawn.host": {
                    "type": "string",
                    "default": "localhost",
                    "description": "Host to attach to."
                },
                "debugpySpawn.justMyCode": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to debug only user code."
                }
            }
        }
    },
    "categories": ["Debuggers"],
    "keywords": ["python", "debugpy", "spawn", "multiprocessing", "pytorch"]
}